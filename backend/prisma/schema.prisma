generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Request {
  id                   String   @id @default(cuid())
  endpoint             String
  taskType             String
  language             String
  userInput            String
  routedModel          String?
  llmOutput            Json?
  staticAnalysisOutput Json?
  success              Boolean  @default(true)
  createdAt            DateTime @default(now())
}